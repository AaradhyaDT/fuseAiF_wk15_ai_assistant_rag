# --- Primary cloud provider (required for gemini to be enabled) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local vLLM server (see Dockerfile.vllm / compose profile "local") ---
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=qwen2.5-1.5b-instruct

# --- Fallback provider running on the host via Ollama ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# --- RAG: leave QDRANT_URL empty for embedded-local mode; set it to use a server ---
QDRANT_URL=
COLLECTION_NAME=wk15_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Orchestration ---
PROVIDER_ORDER=gemini,vllm,ollama
TEMPERATURE=0.2
TOP_P=0.9
MAX_OUTPUT_TOKENS=1024

# --- Reliability ---
RETRY_ATTEMPTS=3
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20
CACHE_TTL_S=300
